**/build


# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
# Note that .so files are not ignored since the repo contains symlinks to such files
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# IDE stuff
*.vscode
*.*~
TAGS

# Build files
*build
*install

# Python
*.pyc
**/*.egg-info
**/__pycache__
**/.hypothesis/*

# Documentation
*docs/_build
*docs/doxyoutput
*docs/api

# Logs
*logs/

# outputs
*outputs/

# Training images
*training_images/

# Self Training logs and outputs
*self_supervision_logs/
*self_supervision_outputs/

# Models
*models/
*isaaclab_arena/embodiments/g1/wbc_policy/models/
*isaaclab_arena/embodiments/g1/wbc_policy/robot_model/

# Datasets
*datasets/
*output/

# Training logs and outputs
*wandb/

# Ignore plots
isaaclab_arena/tests/**.png

# Ignore core dumps produced by debugpy
core

# Local junk / stray artifacts (do not commit)
${data}/
*.etli
/image.png
tools/*_out.txt
core.*

# venvs
**venv_docs/
**/.venv/

# Development and cache folders
/__*

# ROS2
**ros2_ws

# MeshConverter run records: machine-written, only reflect the LAST asset converted,
# and carry a python/tuple tag that check-yaml rejects. Regenerate, do not track.
assets/bdash/config.yaml
assets/bdash/.asset_hash
