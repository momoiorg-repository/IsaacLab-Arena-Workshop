<?xml version="1.0" ?>
<!--
  Robotiq 85 standalone gripper for Isaac Sim USD conversion.
-->
<robot name="robotiq_85" xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- Robotiq 2F-85 gripper macro -->
  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_2f_85_macro.urdf.xacro"/>

  <!-- World link (fixed base) -->
  <link name="world"/>

  <!-- Attach Robotiq 2F-85 gripper to the world -->
  <xacro:robotiq_gripper
    name="RobotiqGripper"
    prefix=""
    parent="world"
    include_ros2_control="false">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:robotiq_gripper>

</robot>
